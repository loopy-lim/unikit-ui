    {
      "name": "animations",
      "type": "registry:style",
      "title": "Animations",
      "description": "오버레이 진입 애니메이션(웹 전용) — lib/overlay 컴포넌트가 클래스명으로 연결하는 unikit-backdrop-in·unikit-dialog-in·unikit-sheet-in-top/bottom/left/right·unikit-popover-in 클래스 7종, keyframes 6종, prefers-reduced-motion 비활성화 규칙. add 시 소비자 전역 CSS에 병합된다(출처: apps/web/app/site.css). 네이티브는 RN Animated로 구동되므로 이 CSS를 쓰지 않는다.",
      "css": {
        ".unikit-backdrop-in": {
          "animation": "unikit-fade-in 180ms ease-out both"
        },
        ".unikit-dialog-in": {
          "animation": "unikit-zoom-in 200ms cubic-bezier(0.22, 1, 0.36, 1) both"
        },
        ".unikit-sheet-in-top": {
          "animation": "unikit-slide-from-top 260ms cubic-bezier(0.22, 1, 0.36, 1) both"
        },
        ".unikit-sheet-in-bottom": {
          "animation": "unikit-slide-from-bottom 260ms cubic-bezier(0.22, 1, 0.36, 1) both"
        },
        ".unikit-sheet-in-left": {
          "animation": "unikit-slide-from-left 260ms cubic-bezier(0.22, 1, 0.36, 1) both"
        },
        ".unikit-sheet-in-right": {
          "animation": "unikit-slide-from-right 260ms cubic-bezier(0.22, 1, 0.36, 1) both"
        },
        ".unikit-popover-in": {
          "animation": "unikit-zoom-in 160ms cubic-bezier(0.22, 1, 0.36, 1) both"
        },
        ".unikit-toast-in": {
          "animation": "unikit-toast-in 220ms cubic-bezier(0.22, 1, 0.36, 1) both"
        },
        "@keyframes unikit-fade-in": {
          "from": {
            "opacity": "0"
          },
          "to": {
            "opacity": "1"
          }
        },
        "@keyframes unikit-zoom-in": {
          "from": {
            "opacity": "0",
            "transform": "scale(0.96)"
          },
          "to": {
            "opacity": "1",
            "transform": "scale(1)"
          }
        },
        "@keyframes unikit-slide-from-top": {
          "from": {
            "opacity": "0",
            "transform": "translateY(-12px)"
          },
          "to": {
            "opacity": "1",
            "transform": "translateY(0)"
          }
        },
        "@keyframes unikit-slide-from-bottom": {
          "from": {
            "opacity": "0",
            "transform": "translateY(16px)"
          },
          "to": {
            "opacity": "1",
            "transform": "translateY(0)"
          }
        },
        "@keyframes unikit-slide-from-left": {
          "from": {
            "opacity": "0",
            "transform": "translateX(-16px)"
          },
          "to": {
            "opacity": "1",
            "transform": "translateX(0)"
          }
        },
        "@keyframes unikit-slide-from-right": {
          "from": {
            "opacity": "0",
            "transform": "translateX(16px)"
          },
          "to": {
            "opacity": "1",
            "transform": "translateX(0)"
          }
        },
        "@keyframes unikit-toast-in": {
          "from": {
            "opacity": "0",
            "transform": "translateY(10px) scale(0.98)"
          },
          "to": {
            "opacity": "1",
            "transform": "translateY(0) scale(1)"
          }
        },
        "@media (prefers-reduced-motion: reduce)": {
          ".unikit-backdrop-in, .unikit-dialog-in, .unikit-sheet-in-top, .unikit-sheet-in-bottom, .unikit-sheet-in-left, .unikit-sheet-in-right, .unikit-popover-in, .unikit-toast-in": {
            "animation": "none"
          }
        }
      }
    },
