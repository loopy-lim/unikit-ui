{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist/nsh-types",
    // 소비 앱의 d.mts가 primitives 지정자를 남기지 않게 — nsh 브리지로
    // 해석해 그 선언을 함께 내린다(web/native 소스는 소비 앱 타입 검사에
    // 들어가지 않는다 — DOM lib·uniwind 의존 제거).
    "paths": {
      "@unikit-bridge/ui/primitives": ["./src/bridge/nsh.tsx"]
    }
  },
  "include": ["src", "nsh-env.d.ts"]
}
