{
  "name": "@unikit-bridge/ui",
  "version": "0.6.0",
  "description": "Bridge UI kit — one component set that renders React Native views on native (uniwind) and plain DOM on web (Tailwind CSS v4). Same className, same look.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopy-lim/unikit-ui.git",
    "directory": "packages/unikit"
  },
  "homepage": "https://github.com/loopy-lim/unikit-ui#readme",
  "bugs": "https://github.com/loopy-lim/unikit-ui/issues",
  "keywords": [
    "react-native",
    "expo",
    "uniwind",
    "react",
    "tailwind",
    "tailwindcss",
    "design-system",
    "ui-components",
    "universal",
    "cross-platform",
    "shadcn"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./a2ui": "./src/a2ui/index.ts",
    "./a2ui/catalog-basic": "./src/a2ui/catalog-basic.tsx",
    "./a2ui/demo": "./src/a2ui/demo.ts",
    "./a2ui/optional": "./src/a2ui/views-optional.tsx",
    "./behaviors": "./src/behaviors/index.ts",
    "./behaviors/ui-sdk": "./src/behaviors/ui-sdk.ts",
    "./behaviors/ui-sdk-agent": "./src/behaviors/ui-sdk-agent.ts",
    "./behaviors/ui-sdk-catalog": "./src/behaviors/ui-sdk-catalog.ts",
    "./behaviors/ui-sdk-dom": "./src/behaviors/ui-sdk-dom.ts",
    "./behaviors/ui-sdk-renderer": "./src/behaviors/ui-sdk-renderer.ts",
    "./chart": {
      "react-native": "./src/chart/native.tsx",
      "default": "./src/chart/web.tsx"
    },
    "./editor": {
      "react-native": "./src/editor/native.tsx",
      "default": "./src/editor/web.tsx"
    },
    "./editor-prose.css": "./src/lib/editor-prose.css",
    "./motion": {
      "react-native": "./src/motion/native.tsx",
      "default": "./src/motion/web.tsx"
    },
    "./overlay-position": {
      "react-native": "./src/lib/overlay-position/native.ts",
      "default": "./src/lib/overlay-position/web.ts"
    },
    "./primitives": {
      "react-native": "./src/bridge/native.tsx",
      "default": "./src/bridge/web.tsx"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "tsc --noEmit",
    "build:editor": "bun run --filter @unikit/editor-web-view build && bun scripts/sync-editor-html.ts",
    "generate:design": "bun scripts/generate-design.ts",
    "audit:design": "bun scripts/audit-design.ts",
    "check:consumer": "bun scripts/check-consumer-theme.ts",
    "probe:ui-sdk": "bun scripts/ui-sdk-contract-probe.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^3.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.81.0",
    "uniwind": ">=1.13.0",
    "react-native-svg": ">=15.0.0",
    "react-hook-form": "^7.0.0",
    "lucide-react": "^1.71.0",
    "lucide-react-native": "^1.71.0",
    "@a2ui/web_core": "~0.16.1",
    "zod": "^3.25.76",
    "@tiptap/extensions": "^3.0.0",
    "@tiptap/markdown": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "react-native-webview": "^14.0.0",
    "react-native-reanimated": ">=4.0.0",
    "@ui-sdk/core": "0.1.0-beta.6"
  },
  "peerDependenciesMeta": {
    "@a2ui/web_core": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "uniwind": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "lucide-react-native": {
      "optional": true
    },
    "@tiptap/extensions": {
      "optional": true
    },
    "@tiptap/markdown": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "@ui-sdk/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@a2ui/web_core": "~0.16.1",
    "@tiptap/extensions": "^3.0.0",
    "@tiptap/markdown": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "lucide-react": "^1.71.0",
    "lucide-react-native": "^1.71.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "~7.65.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "~15.16.0",
    "react-native-webview": "14.0.1",
    "tailwind-merge": "~3.7.0",
    "typescript": "~5.9.0",
    "uniwind": "~1.13.2",
    "zod": "~3.25.76"
  }
}
