{
  "name": "@unikit-bridge/ui",
  "version": "0.3.0",
  "description": "Bridge UI kit — one component set that renders React Native views on native (uniwind) and plain DOM on web (Tailwind CSS v4). Same className, same look.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loopy-lim/unikit-ui.git",
    "directory": "packages/unikit"
  },
  "homepage": "https://github.com/loopy-lim/unikit-ui#readme",
  "bugs": "https://github.com/loopy-lim/unikit-ui/issues",
  "keywords": [
    "react-native",
    "expo",
    "uniwind",
    "react",
    "tailwind",
    "tailwindcss",
    "design-system",
    "ui-components",
    "universal",
    "cross-platform",
    "shadcn"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./primitives": {
      "react-native": "./src/bridge/native.tsx",
      "default": "./src/bridge/web.tsx"
    },
    "./chart": {
      "react-native": "./src/chart/native.tsx",
      "default": "./src/chart/web.tsx"
    },
    "./editor-prose.css": "./src/lib/editor-prose.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc --noEmit",
    "generate:design": "bun scripts/generate-design.ts",
    "audit:design": "bun scripts/audit-design.ts",
    "check:consumer": "bun scripts/check-consumer-theme.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^3.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.81.0",
    "uniwind": ">=1.13.0",
    "react-native-svg": ">=15.0.0",
    "react-hook-form": "^7.0.0",
    "lucide-react": "^1.71.0",
    "lucide-react-native": "^1.71.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "uniwind": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "lucide-react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react-dom": "~19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "~15.16.0",
    "react-hook-form": "~7.65.0",
    "uniwind": "~1.13.2",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "tailwind-merge": "~3.7.0",
    "lucide-react": "^1.71.0",
    "lucide-react-native": "^1.71.0"
  }
}
