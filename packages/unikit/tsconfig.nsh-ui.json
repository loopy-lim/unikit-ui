{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "ESNext.Disposable", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "nsh",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "nsh": ["./nsh-types/index.d.ts"],
      "nsh/*": ["./nsh-types/*.d.ts"]
    }
  },
  "include": ["src/nsh-ui", "nsh-types"],
  "files": ["nsh-types/globals.d.ts", "nsh-types/assets.d.ts", "nsh-types/tokens.d.ts"]
}
